{
  "name": "roomless-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run build:gateway && npm run build:user-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" scripts/*.mjs vitest.config.ts vitest.setup.ts",
    "lint": "oxlint apps/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "build:gateway": "nest build gateway",
    "build:user-service": "nest build user-service",
    "start:gateway": "nest start gateway --watch",
    "start:user-service": "nest start user-service --watch",
    "start:prod:gateway": "node dist/apps/gateway/apps/gateway/src/main.js",
    "start:prod:user-service": "node dist/apps/user-service/apps/user-service/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docker:network": "node scripts/docker-network.mjs",
    "docker:postgres": "docker compose -f compose.postgres.yml up -d --wait",
    "docker:rabbitmq": "docker compose -f compose.rabbitmq.yml up -d --wait rabbitmq && docker compose -f compose.rabbitmq.yml run --rm -T rabbitmq-init",
    "docker:user-service": "docker compose -f compose.user-service.yml up -d --build",
    "docker:gateway": "docker compose -f compose.gateway.yml up -d --build",
    "docker:infra": "npm run docker:network && npm run docker:postgres && npm run docker:rabbitmq",
    "docker:up": "npm run docker:infra && npm run docker:user-service && npm run docker:gateway",
    "docker:down": "docker compose -f compose.gateway.yml down && docker compose -f compose.user-service.yml down && docker compose -f compose.rabbitmq.yml down && docker compose -f compose.postgres.yml down",
    "docker:logs:gateway": "docker compose -f compose.gateway.yml logs -f gateway gateway-lb",
    "docker:logs:user-service": "docker compose -f compose.user-service.yml logs -f user-service user-service-lb",
    "broker:check": "node scripts/check-broker-acl.mjs",
    "db:migrate": "nest build user-service && node dist/apps/user-service/apps/user-service/src/migrate.js",
    "db:revert": "nest build user-service && node dist/apps/user-service/apps/user-service/src/migrate.js revert",
    "db:check": "nest build user-service && node scripts/db-schema.mjs check",
    "db:generate": "nest build user-service && node scripts/db-schema.mjs generate"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^2.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.7",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^7.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
