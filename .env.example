# 실행환경 (production 일 때만 탈퇴 자동처리 crontab 이 실제로 돈다)
NODE_ENV=development

# 포트
GATEWAY_PORT=3000
USER_SERVICE_PORT=4001
# user-service 바인딩 주소 — 기본 127.0.0.1(같은 머신의 게이트웨이만). Docker 에서는 compose 가 0.0.0.0 으로 덮어쓰고 포트는 공개하지 않는다
USER_SERVICE_HOST=127.0.0.1

# 게이트웨이 → 서비스
USER_SERVICE_URL=http://localhost:4001
# 게이트웨이와 서비스가 공유하는 내부 요청 비밀값 (비어 있으면 서비스가 모든 내부 요청을 거부한다)
INTERNAL_API_TOKEN=
INTERNAL_HTTP_TIMEOUT_MS=10000
# 큐 경로 SSE 대기 시간 — 넘기면 event: pending 후 종료
COMMAND_STREAM_TIMEOUT_MS=30000
# 비우면 gw-<호스트>-<pid> (게이트웨이를 여러 대 띄울 때 인스턴스마다 달라야 한다)
GATEWAY_INSTANCE_ID=

# 게이트웨이에 접근을 허용할 프론트 주소 (쉼표 구분, * = 전체). 비우면 다른 출처의 브라우저 요청을 모두 막는다
CORS_ORIGINS=http://localhost:3001

# Swagger (게이트웨이)
SWAGGER_TITLE=Roomless API
SWAGGER_PATH=swagger

# PostgreSQL — docker compose 가 같은 값으로 컨테이너를 만든다 (아래 *_URL · USER_SERVICE_URL 의 localhost 는 로컬 실행용, 컨테이너에서는 compose 가 서비스 이름으로 덮어쓴다)
POSTGRES_USER=roomless
POSTGRES_PASSWORD=roomless
POSTGRES_DB=roomless
POSTGRES_PORT=5432
# 앱(PrismaService)과 Prisma CLI 가 함께 쓴다
DATABASE_URL=postgresql://roomless:roomless@localhost:5432/roomless?schema=public
DATABASE_POOL_SIZE=10

# RabbitMQ — docker compose 가 같은 값으로 컨테이너와 계정을 만든다 (관리 화면 http://localhost:15672)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# 관리자 계정 — 관리 화면 · 계정 초기화(rabbitmq-init) 전용, 앱은 쓰지 않는다
RABBITMQ_USER=roomless
RABBITMQ_PASSWORD=roomless
# 앱별 브로커 계정 비밀번호 (계정 이름은 gateway · user-service 고정, 큰따옴표 · 역슬래시 금지)
# 명령(roomless.cmd)은 gateway 계정만 발행할 수 있다 — 운영에서는 이 비밀번호를 게이트웨이에만 둔다
RABBITMQ_GATEWAY_PASSWORD=
RABBITMQ_USER_SERVICE_PASSWORD=

# 인증
JWT_SECRET=
# 비밀번호 해시 pepper (가입이 시작된 뒤 바꾸면 기존 비밀번호를 검증할 수 없다)
BCRYPT_CODE=
# 비밀번호 해시 라운드(cost) — 반드시 4~31 사이 정수로 지정한다. 1 올릴 때마다 해시 시간 2배, 바꿔도 기존 해시는 그대로 검증된다. 없으면 12
BCRYPT_ROUNDS=12
# refresh_token 복원용 AES-256-GCM 키 (32바이트 hex 64자)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_CIPHER_KEY=
