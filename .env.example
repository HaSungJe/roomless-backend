# 서버 설정 — 로컬 실행과 Docker 가 이 값을 그대로 쓴다 (compose 는 바꾸지 않는다)
# 가상 운영 · 실제 운영은 DB · RabbitMQ 주소로 고른다 — 자세한 설명은 docs/architecture.md 의 "설정"
# (필수) 가 붙은 값이 비어 있으면 Docker 가 뜨지 않는다

# ── 실행 환경 ───────────────────────────────
# production: 운영(가상 · 실제) / development: 로컬 디버깅 전용 (JWT 만료를 검사하지 않음)
NODE_ENV=production

# ── 게이트웨이 ──────────────────────────────
# Docker 에서는 로드밸런서가 호스트에 여는 포트
GATEWAY_PORT=3000
# 허용할 프론트 주소 (쉼표 구분, * = 전체, 비우면 모두 차단)
CORS_ORIGINS=http://localhost:3001
# 앞단 프록시 수 — 비우면 Docker 는 1, 로컬은 사용 안 함. ALB 뒤에 두면 2
TRUST_PROXY=
# 큐 경로 SSE 대기 시간(ms) — 넘기면 pending
COMMAND_STREAM_TIMEOUT_MS=30000
# 로컬 실행용 인스턴스 ID — 비우면 자동 (Docker 는 컨테이너마다 자동)
GATEWAY_INSTANCE_ID=
SWAGGER_TITLE=Roomless API
SWAGGER_PATH=swagger

# ── 게이트웨이 → user-service · admin-service ─
# 로컬 실행용 주소 (Docker 는 http://user-service-lb:4001 · http://admin-service-lb:4002 고정)
USER_SERVICE_URL=http://localhost:4001
ADMIN_SERVICE_URL=http://localhost:4002
# (필수) 내부 요청 비밀값 — 게이트웨이와 서비스들이 같은 값을 쓴다
INTERNAL_API_TOKEN=
INTERNAL_HTTP_TIMEOUT_MS=10000

# ── user-service ────────────────────────────
USER_SERVICE_PORT=4001
# 로컬 실행용 바인딩 주소 (Docker 는 0.0.0.0 고정)
USER_SERVICE_HOST=127.0.0.1
# 같은 휴대폰 번호로 하루(한국 날짜)에 보낼 수 있는 인증 SMS 수 — 비우면 10 (user-service · admin-service 공통)
SMS_VERIFICATION_DAILY_LIMIT=10

# ── admin-service (매니저 · 관리자) ─────────
ADMIN_SERVICE_PORT=4002
# 로컬 실행용 바인딩 주소 (Docker 는 0.0.0.0 고정)
ADMIN_SERVICE_HOST=127.0.0.1

# ── 인스턴스 수 (Docker) ────────────────────
GATEWAY_REPLICAS=2
USER_SERVICE_REPLICAS=2
ADMIN_SERVICE_REPLICAS=1
# scheduler(crontab 전용 — 들어오는 연결 없음). 여러 대여도 DB 잠금으로 회차마다 1대만 실행한다
SCHEDULER_REPLICAS=1

# ── PostgreSQL ──────────────────────────────
# (필수) 가상 운영 DB 컨테이너 계정 — 서버에서는 반드시 바꾼다
POSTGRES_USER=roomless
POSTGRES_PASSWORD=roomless
POSTGRES_DB=roomless
POSTGRES_PORT=5432
# (필수) 앱이 접속할 DB — 가상 운영은 @postgres, 실제 운영은 RDS 등의 주소
DATABASE_URL=postgresql://roomless:roomless@postgres:5432/roomless?schema=public
DATABASE_POOL_SIZE=10
# 풀에서 DB 연결을 기다리는 최대 시간(ms) — 넘기면 그 요청은 500(큐 경로는 재시도). 비우면 30000
DATABASE_CONNECTION_TIMEOUT_MS=30000

# ── RabbitMQ ────────────────────────────────
# (필수) 앱이 접속할 브로커 — 가상 운영은 rabbitmq, 실제 운영은 Amazon MQ 등의 주소
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# (필수) 관리자 계정 — 관리 화면 · 계정 초기화 전용, 서버에서는 반드시 바꾼다
RABBITMQ_USER=roomless
RABBITMQ_PASSWORD=roomless
# (필수) 앱별 브로커 계정 비밀번호 — 큰따옴표 · 역슬래시 금지
RABBITMQ_GATEWAY_PASSWORD=
RABBITMQ_USER_SERVICE_PASSWORD=
RABBITMQ_ADMIN_SERVICE_PASSWORD=

# ── 인증 · 암호화 ───────────────────────────
# (필수)
JWT_SECRET=
# 비밀번호 해시 pepper — 가입이 시작된 뒤 바꾸면 기존 비밀번호를 검증할 수 없다
BCRYPT_CODE=
# 비밀번호 해시 라운드 — 반드시 4~31 사이 정수 (기본 12)
BCRYPT_ROUNDS=12
# (필수) refresh_token 암호화 키, hex 64자
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_CIPHER_KEY=

# ── AWS (SMS · 파일 저장) ───────────────────
# 세팅 방법: docs/guides/aws-setup.md — 비어 있으면 부팅은 되고 SMS · 파일 요청만 실패한다
AWS_REGION=ap-northeast-2
# IAM 사용자 액세스 키 — AWS(EC2 · ECS)에서 IAM 역할로 돌리면 비운다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 사진 버킷
AWS_S3_BUCKET=
# 사진 공개 주소의 기준 — 버킷 주소 https://<버킷>.s3.<리전>.amazonaws.com 또는 CloudFront 주소. 비어 있으면 사진 주소 요청이 실패한다
AWS_S3_PUBLIC_URL=
